{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omodachi.dev/contracts/v1/state.schema.json",
  "title": "Device-level state snapshot",
  "type": "object",
  "properties": {
    "contract_revision": {
      "const": "omodachi.v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "event_cursor": {
      "type": "integer",
      "minimum": 0
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "host": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "connected": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "fixture",
            "local"
          ]
        },
        "graphical_state": {
          "enum": [
            "fixture",
            "available",
            "unavailable"
          ]
        },
        "catalog_stale": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "connected"
      ],
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "active": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "items": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "active",
              "window_count",
              "occupied",
              "persistent",
              "select_entry_id",
              "move_entry_id"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "active": {
                "type": "boolean"
              },
              "window_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10000
              },
              "occupied": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "persistent": {
                "type": "boolean",
                "description": "Part of the fixed 1-5 set the official bar always draws."
              },
              "select_entry_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "pattern": "^omodachi\\.workspace\\.select\\.(?:[1-9]|10)$"
              },
              "move_entry_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "pattern": "^omodachi\\.workspace\\.move\\.(?:[1-9]|10)$"
              }
            },
            "additionalProperties": false
          }
        },
        "layout_binding": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "instance_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "workspace_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "layout": {
                  "enum": [
                    "dwindle",
                    "scrolling"
                  ]
                }
              },
              "required": [
                "workspace_id",
                "layout",
                "revision",
                "instance_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "active"
      ],
      "additionalProperties": false
    },
    "focus": {
      "type": "object",
      "properties": {
        "window": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_token": {
          "type": [
            "string",
            "null"
          ]
        },
        "app_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "app_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "description": "The focused window's icon as its desktop entry declares it. An XDG icon name or an absolute path is fetched from GET /v1/icons/{name}.",
          "type": "string",
          "minLength": 0,
          "maxLength": 1024
        },
        "icon_kind": {
          "enum": [
            "glyph",
            "xdg",
            "path",
            "none"
          ]
        }
      },
      "required": [
        "window"
      ],
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "exists": {
          "type": "boolean"
        },
        "pane_available": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "idle",
            "working",
            "blocked",
            "done",
            "unknown",
            "waiting_on_approval",
            "waiting_on_user_input"
          ]
        },
        "default_agent": {
          "$ref": "schemas/default-agent-capabilities.schema.json"
        },
        "last_confirmed": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "schemas/default-agent-capabilities.schema.json"
            }
          ]
        },
        "chat": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "status": {
              "$ref": "agent-chat-snapshot.schema.json#/properties/status"
            },
            "pending_approvals": {
              "type": "integer",
              "minimum": 0
            },
            "activity": {
              "description": "MOTION-1: what the provider's current or last turn is doing, from its own turn and item events, for the animated face. thinking = turn started with no item yet, or reasoning; working = an agent message is streaming; tool = a command, file change or tool call is in progress; done = the last turn completed; error = it failed; stopped = the user interrupted it (INTEGRATE-2: a calm state, not an error); offline = the provider connection is gone; idle = no turn since attach. done/error/stopped stay until the next turn starts; whether they were seen is the client's to remember, by turn_id.",
              "type": "object",
              "properties": {
                "phase": {
                  "enum": ["idle", "thinking", "working", "tool", "done", "error", "stopped", "offline"]
                },
                "turn_id": {
                  "type": ["string", "null"],
                  "maxLength": 128
                }
              },
              "required": ["phase", "turn_id"],
              "additionalProperties": false
            },
            "approval": {
              "description": "NOTIFY-1: the oldest pending approval, ids only - what a phone's alert needs to offer Allow / Deny on exactly that request, never what it asks. decidable is false for a question that needs a typed answer or a choice. Null when none is pending; absent from a core before NOTIFY-1.",
              "anyOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "required": ["request_id", "kind", "fingerprint", "decidable"],
                  "additionalProperties": false,
                  "properties": {
                    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
                    "kind": {"enum": ["commandExecution", "fileChange", "permissions", "userInput"]},
                    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
                    "decidable": {"type": "boolean"}
                  }
                }
              ]
            }
          },
          "required": [
            "status",
            "pending_approvals"
          ],
          "additionalProperties": false
        },
        "usage": {
          "$ref": "agent-chat-snapshot.schema.json#/properties/usage"
        }
      },
      "required": [
        "kind",
        "exists",
        "pane_available",
        "status"
      ],
      "additionalProperties": false
    },
    "herdr": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "agent_count": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot": {
          "$ref": "schemas/herdr-status.schema.json"
        },
        "agent_count_scope": {
          "enum": [
            "default_agent_only"
          ]
        },
        "blocked": {
          "description": "NOTIFY-2: per watched Herdr session, the panes whose agent is blocked at the last two-second poll (ids and the agent's name only) - the first look a client compares the next herdr.layout.changed against. Absent without a Herdr bridge.",
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": [
                "pane_id",
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "pane_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 32
                }
              }
            }
          }
        }
      },
      "required": [
        "available",
        "agent_count"
      ],
      "additionalProperties": false
    },
    "notifications": {
      "type": "object",
      "properties": {
        "dnd": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "dnd"
      ],
      "additionalProperties": false
    },
    "remote": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "offline",
            "creating",
            "ready",
            "resizing",
            "stopping",
            "failed",
            "released"
          ]
        },
        "mode": {
          "enum": [
            "extend",
            "takeover",
            null
          ]
        },
        "backend": {
          "enum": [
            "sunshine",
            "vnc",
            null
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "session_id",
        "state",
        "mode",
        "backend",
        "revision"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "$ref": "capabilities.schema.json"
    },
    "catalog": {
      "anyOf": [
        {
          "$ref": "catalog.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "revision": {
              "type": "null"
            },
            "entries": {
              "type": "array",
              "items": {},
              "maxItems": 0
            }
          },
          "required": [
            "revision",
            "entries"
          ],
          "additionalProperties": false
        },
        {
          "description": "HERDR-11: the client sent `X-Omodachi-Catalog: <revision>` and that is still the catalog's revision, so the rows are not sent again (they were most of a ~590 KB state read). The client keeps the rows it holds. A client that sends no header always gets the rows.",
          "type": "object",
          "properties": {
            "contract_revision": {
              "const": "omodachi.v1"
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "source_revision": {
              "type": "string",
              "minLength": 1
            },
            "entries": {
              "type": "array",
              "items": {},
              "maxItems": 0
            },
            "unchanged": {
              "const": true
            }
          },
          "required": [
            "revision",
            "entries",
            "unchanged"
          ],
          "additionalProperties": false
        }
      ]
    },
    "bar": {
      "$ref": "bar.schema.json"
    },
    "remote_bar": {
      "$ref": "remote-bar.schema.json"
    },
    "desk": {
      "description": "NOTIFY-1: whether the person is at this computer right now - the compositor's own idle timer (ext-idle-notify, 2 min without input), no screen locker running, and no Remote session driving it from a phone. present is true only for state using. unknown (source unavailable) means the idle timer could not be read, and nothing is ever held because of it. Absent until core's first reading, and from a core before NOTIFY-1.",
      "type": "object",
      "required": ["present", "state", "source"],
      "additionalProperties": false,
      "properties": {
        "present": {"type": "boolean"},
        "state": {"enum": ["using", "idle", "locked", "remote", "unknown"]},
        "source": {"enum": ["wayland", "unavailable"]}
      }
    },
    "unseen": {
      "description": "NOTIFY-1: finished but not yet seen. agent: the Agent conversation's last turn ended (done or error) after any device last had it open. herdr: panes whose agent went working or blocked -> idle or done after any device last had the pane open or typed into it (ids and the agent's name only). A pane's first sighting is never unseen. Absent from a core before NOTIFY-1.",
      "type": "object",
      "required": ["agent", "herdr"],
      "additionalProperties": false,
      "properties": {
        "agent": {"type": "boolean"},
        "herdr": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["session", "pane_id", "name"],
            "additionalProperties": false,
            "properties": {
              "session": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
              "pane_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "name": {"type": ["string", "null"], "maxLength": 32}
            }
          }
        }
      }
    },
    "overview": {
      "description": "OVERVIEW-1: one list of everything that wants the person - the Agent conversation and every pane with an agent in every running Herdr session. state: needs_you (an approval, a question, a pane Herdr reports blocked), working (a turn running, a pane Herdr reports working), done (finished with nobody looking since, NOTIFY-1's ledger). ask says what is asked in a few words: approve_command / approve_files / approve_permissions / approve / answer for the Agent's pending approval (its kind only, never what it asks); pick (a numbered list with one option marked) or yes_no (a (y/n) question) for a blocked pane whose screen reads as one, with the line above the options as question, else waiting; your_move for a finished pane whose agent's own latest reply ends in a question (the question), else finished (failed for an Agent turn that ended in an error); working while working. Rows are in position order, never status order: the Agent first, then sessions by name and each session's panes in layout order; the default agent's own pane in the owned session is the Agent row, not a Herdr row. counts and sessions are taken before rows is cut to 64. Absent from a core before OVERVIEW-1.",
      "type": "object",
      "required": ["rows", "counts", "sessions"],
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["id", "source", "state", "ask", "question", "agent", "session", "pane_id", "workspace_id", "workspace", "pane"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 200},
              "source": {"enum": ["agent", "herdr"]},
              "state": {"enum": ["needs_you", "working", "done"]},
              "ask": {"enum": ["approve_command", "approve_files", "approve_permissions", "approve", "answer", "pick", "yes_no", "waiting", "working", "your_move", "finished", "failed"]},
              "question": {"type": ["string", "null"], "maxLength": 120},
              "agent": {"type": ["string", "null"], "maxLength": 32},
              "session": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
              "pane_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
              "workspace_id": {"type": ["string", "null"], "maxLength": 128},
              "workspace": {"type": ["string", "null"], "maxLength": 48},
              "pane": {"type": ["string", "null"], "maxLength": 48}
            }
          }
        },
        "counts": {
          "type": "object",
          "required": ["needs_you", "working", "done"],
          "additionalProperties": false,
          "properties": {
            "needs_you": {"type": "integer", "minimum": 0},
            "working": {"type": "integer", "minimum": 0},
            "done": {"type": "integer", "minimum": 0}
          }
        },
        "sessions": {
          "description": "Per running Herdr session: how many of its panes are in each state (the Agent is not counted here).",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["name", "needs_you", "working", "done"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
              "needs_you": {"type": "integer", "minimum": 0},
              "working": {"type": "integer", "minimum": 0},
              "done": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "wake": {
      "type": "object",
      "required": [
        "screensaver_active",
        "display_asleep",
        "locked"
      ],
      "properties": {
        "screensaver_active": {
          "type": "boolean"
        },
        "display_asleep": {
          "type": "boolean"
        },
        "locked": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "wake_pending": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "contract_revision",
    "revision",
    "event_cursor",
    "instance_id",
    "device_id",
    "host",
    "workspace",
    "focus",
    "agent",
    "herdr",
    "capabilities",
    "catalog",
    "remote",
    "notifications"
  ],
  "additionalProperties": false
}
