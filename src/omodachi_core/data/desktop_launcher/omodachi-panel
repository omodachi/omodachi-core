#!/usr/bin/env python3
"""Open the local Omodachi plugin panel; no media or daemon credential needed."""
import json
import os
import subprocess
import sys

def main():
    if len(sys.argv)!=1:
        print(json.dumps({'requested':False,'error':'arguments_not_supported'}));return 2
    environment=dict(os.environ);environment['OMARCHY_PATH']='/usr/share/omarchy'
    command=('omarchy-shell','shell','summon','com.omodachi.host','{"view":"overview"}')
    try:
        result=subprocess.run(command,env=environment,stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=5,shell=False)
        ok=result.returncode==0
    except (OSError,subprocess.SubprocessError):ok=False
    print(json.dumps({'requested':ok,'surface':'local_plugin_panel',**({} if ok else {'error':'omarchy_panel_unavailable'})}))
    return 0 if ok else 1
if __name__=='__main__':raise SystemExit(main())
