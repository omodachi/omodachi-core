{
  "omodachi": {
    "label": "Omodachi",
    "icon": ""
  },
  "omodachi.desktop": {
    "label": "Remote screen",
    "surface": "desktop"
  },
  "omodachi.agent": {
    "label": "Agent",
    "surface": "terminal"
  },
  "omodachi.herdr": {
    "label": "Herdr",
    "surface": "terminal"
  },
  "omodachi.workspace": {
    "label": "Workspaces",
    "aliases": [
      "workspace",
      "ws"
    ]
  },
  "omodachi.workspace.select": {
    "label": "Switch workspace"
  },
  "omodachi.workspace.move": {
    "label": "Move focused window"
  },
  "omodachi.workspace.select.1": {
    "label": "Workspace 1",
    "aliases": [
      "1",
      "workspace 1",
      "ws 1"
    ],
    "surface": "host",
    "action": "omodachi-host workspace select 1",
    "workspace": {
      "id": 1,
      "operation": "select"
    }
  },
  "omodachi.workspace.move.1": {
    "label": "Move focused window to Workspace 1",
    "aliases": [
      "move to 1",
      "move workspace 1"
    ],
    "surface": "host",
    "action": "omodachi-host workspace move-focused 1",
    "when": "omodachi-focus-available",
    "workspace": {
      "id": 1,
      "operation": "move_focused"
    }
  },
