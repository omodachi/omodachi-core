{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omodachi.dev/contracts/v1/remote-bar.schema.json",
  "title": "Live remote output and host workspaces",
  "type": "object",
  "properties": {
    "active": {
      "type": "boolean"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "viewport": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "logical_size": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "orientation": {
      "enum": [
        "portrait",
        "landscape",
        null
      ]
    },
    "revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "monitor",
          "windows",
          "active",
          "remote"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "monitor": {
            "type": [
              "string",
              "null"
            ]
          },
          "windows": {
            "type": "integer",
            "minimum": 0
          },
          "active": {
            "type": "boolean"
          },
          "remote": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "active",
    "session_id",
    "output_name",
    "viewport",
    "logical_size",
    "orientation",
    "revision",
    "workspaces"
  ],
  "additionalProperties": false
}
