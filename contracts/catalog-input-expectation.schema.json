{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omodachi.dev/contracts/v1/catalog-input-expectation.schema.json",
  "title": "JSONC input expectation",
  "type": "object",
  "properties": {
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "required_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "route_expectations": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "host",
          "terminal",
          "desktop",
          "native"
        ]
      }
    }
  },
  "required": [
    "notes",
    "required_ids",
    "route_expectations"
  ],
  "additionalProperties": false
}
