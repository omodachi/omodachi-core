{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omodachi.dev/contracts/v1/agent-chat-approvals.schema.json",
  "title": "Pending default-agent approvals",
  "type": "object",
  "properties": {
    "contract_revision": {
      "const": "omodachi.v1"
    },
    "agent_id": {
      "const": "default"
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "commandExecution",
              "fileChange",
              "permissions",
              "userInput"
            ]
          },
          "summary": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$",
            "description": "NOTIFY-1: 16 hex characters that change whenever what this approval shows changes. A decision sent from an alert carries it, and core sends nothing when it no longer matches (409 agent_approval_changed)."
          },
          "decisions": {
            "type": "array",
            "items": {
              "enum": [
                "accept",
                "acceptForSession",
                "decline",
                "cancel"
              ]
            }
          }
        },
        "required": [
          "request_id",
          "kind",
          "summary",
          "details",
          "decisions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_revision",
    "agent_id",
    "requests"
  ],
  "additionalProperties": false
}
