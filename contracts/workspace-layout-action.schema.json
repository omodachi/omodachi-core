{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omodachi.dev/contracts/v1/workspace-layout-action.schema.json",
  "title": "Workspace binding on existing actions.invoke",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "from_layout": {
          "enum": [
            "dwindle",
            "scrolling"
          ]
        },
        "layout": {
          "enum": [
            "dwindle",
            "scrolling"
          ]
        }
      },
      "required": [
        "workspace_id",
        "from_layout",
        "layout"
      ],
      "additionalProperties": false,
      "not": {
        "anyOf": [
          {
            "properties": {
              "from_layout": {
                "const": "dwindle"
              },
              "layout": {
                "const": "dwindle"
              }
            }
          },
          {
            "properties": {
              "from_layout": {
                "const": "scrolling"
              },
              "layout": {
                "const": "scrolling"
              }
            }
          }
        ]
      }
    },
    "effects": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "from_layout": {
          "enum": [
            "dwindle",
            "scrolling"
          ]
        },
        "layout": {
          "enum": [
            "dwindle",
            "scrolling"
          ]
        },
        "runtime_applied": {
          "type": "boolean"
        },
        "persistent_applied": {
          "type": "boolean"
        },
        "readback_confirmed": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "applied",
            "partial",
            "failed"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,95}$"
        }
      },
      "required": [
        "workspace_id",
        "from_layout",
        "layout",
        "runtime_applied",
        "persistent_applied",
        "readback_confirmed",
        "status",
        "code"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "applied"
              }
            }
          },
          "then": {
            "properties": {
              "runtime_applied": {
                "const": true
              },
              "persistent_applied": {
                "const": true
              },
              "readback_confirmed": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "entry_id": {
          "const": "trigger.toggle.workspace-layout"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "catalog_revision": {
          "type": "string",
          "minLength": 1
        },
        "state_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "params": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "from_layout": {
              "enum": [
                "dwindle",
                "scrolling"
              ]
            },
            "layout": {
              "enum": [
                "dwindle",
                "scrolling"
              ]
            }
          },
          "required": [
            "workspace_id",
            "from_layout",
            "layout"
          ],
          "additionalProperties": false,
          "not": {
            "anyOf": [
              {
                "properties": {
                  "from_layout": {
                    "const": "dwindle"
                  },
                  "layout": {
                    "const": "dwindle"
                  }
                }
              },
              {
                "properties": {
                  "from_layout": {
                    "const": "scrolling"
                  },
                  "layout": {
                    "const": "scrolling"
                  }
                }
              }
            ]
          }
        },
        "workspace_binding": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "instance_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "revision",
            "instance_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "entry_id",
        "request_id",
        "catalog_revision",
        "state_revision",
        "params"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "workspace_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "layout": {
          "enum": [
            "dwindle",
            "scrolling"
          ]
        }
      },
      "required": [
        "workspace_id",
        "layout",
        "revision",
        "instance_id"
      ],
      "additionalProperties": false
    }
  }
}
